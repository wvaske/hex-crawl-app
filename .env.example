# HexCrawl VTT — configuration contract
#
# Copy to `.env` at the repo root (or next to your docker-compose file) and edit.
# `.env` is gitignored and MUST NEVER be committed: it is where instance-specific
# values live. Every value below is optional — the defaults shown are what the
# app uses when the variable is unset.
#
# Precedence: real environment variables always win over this file. The server
# reads `.env` only to fill in variables that are not already set, so compose
# `environment:`, `docker run -e`, and systemd units override it.
#
# Nothing here is a secret today. Per-campaign DM/player join secrets are
# generated by the app and stored in the database (DATA_DIR) — not in config.

# ---------------------------------------------------------------------------
# Server (packages/server/src/config.ts)
# ---------------------------------------------------------------------------

# TCP port the HTTP + WebSocket server listens on.
# Default: 3000
PORT=3000

# Interface to bind. 0.0.0.0 listens on all interfaces (required inside Docker).
# Use 127.0.0.1 to accept only local connections, e.g. behind a host reverse proxy.
# Default: 0.0.0.0
HOST=0.0.0.0

# Directory holding ALL persistent state: the SQLite database (hexcrawl.db) and
# uploaded map images (uploads/). Back up a deployment by copying this directory;
# restore by putting it back. Must be writable by the server process.
# Default: ../../data relative to packages/server (i.e. ./data in a source checkout)
# In the official container image this is /data, backed by a volume.
DATA_DIR=./data

# Absolute or relative path to the built client (packages/client/dist). When set
# and it contains index.html, the server also serves the web UI and falls back to
# index.html for deep links. Leave unset in development — Vite serves the client
# on :5173 instead.
# Default: unset (API/WebSocket only)
# In the official container image this is /app/client-dist.
# CLIENT_DIST=./packages/client/dist

# ---------------------------------------------------------------------------
# MCP server (mcp/hexcrawl-mcp.mjs) — optional, only for AI integrations
# ---------------------------------------------------------------------------
# These are read by the standalone MCP process, not by the app server. They are
# usually passed via `claude mcp add -e ...` rather than a .env file. HEXCRAWL_TOKEN
# IS A SECRET: it is a campaign's DM key, which grants full DM access to that
# campaign. Treat it like a password and never commit it.
#
# HEXCRAWL_URL=http://localhost:3000
# HEXCRAWL_CAMPAIGN=<campaign id from the DM link>
# HEXCRAWL_TOKEN=<campaign DM key>

# ---------------------------------------------------------------------------
# Coming soon — not read by any code yet. Documented here so the field names are
# stable and operators can provision them ahead of time.
# ---------------------------------------------------------------------------

# MediaWiki integration: let the server read/write campaign wiki pages directly
# instead of going through the MCP bridge. WIKI_BOT_PASSWORD IS A SECRET
# (MediaWiki Special:BotPasswords grant) — keep it out of the repo and rotate it
# if it is ever exposed.
# WIKI_API_URL=https://wiki.example.com/api.php
# WIKI_BOT_USER=HexCrawlBot@hexcrawl
# WIKI_BOT_PASSWORD=<bot password>

# Alternate database backend (Postgres) for multi-instance deployments. Unset
# means the built-in SQLite file under DATA_DIR, which is the supported path today.
# CONTAINS A SECRET (the database password) when set.
# DATABASE_URL=postgres://user:password@host:5432/hexcrawl

# Canonical externally-visible base URL, used to build join links shown in the
# Setup tab. Unset means links are built from the browser's current origin.
# PUBLIC_URL=https://hexcrawl.example.com
