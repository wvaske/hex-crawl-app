{
  "name": "@hexcrawl/server",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/plugins.mjs && tsx watch src/index.ts",
    "build": "pnpm run bundle",
    "start": "node dist/server.mjs",
    "test": "node ../../scripts/plugins.mjs && vitest run",
    "typecheck": "node ../../scripts/plugins.mjs && tsc --noEmit",
    "bundle": "node ../../scripts/plugins.mjs && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --external:better-sqlite3 --external:pg-native --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@hexcrawl/shared": "workspace:*",
    "@hono/node-server": "^1.14.0",
    "better-sqlite3": "^12.4.0",
    "hono": "^4.11.0",
    "nanoid": "^5.0.9",
    "pg": "^8.23.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.0",
    "vitest": "^4.0.18"
  },
  "exports": {
    "./plugin-api": "./src/plugins/api.ts",
    "./plugin-testing": "./src/plugins/testing.ts"
  }
}
